<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TOP BLACK SECTION -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="80dp"
        android:paddingBottom="380dp">

        <!-- LOGO CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#1C1C1E"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Circle avatar placeholder -->
                <View
                    android:background="@drawable/circle_gray"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Text bar 1 -->
                <View
                    android:background="@drawable/rounded_bar_gray"
                    android:layout_width="64dp"
                    android:layout_height="6dp"
                    android:layout_marginBottom="6dp"/>

                <!-- Text bar 2 -->
                <View
                    android:background="@drawable/rounded_bar_gray"
                    android:layout_width="48dp"
                    android:layout_height="6dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TITLE -->
        <TextView
            android:text="CareerBridge"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:letterSpacing="-0.02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- SUBTITLE -->
        <TextView
            android:text="Connect with top employers across the Philippines"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>


    <!-- BOTTOM WHITE CARD -->
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bottom_card_background"
        android:padding="20dp"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="380dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@drawable/handle_bar"/>
        <!-- FEATURE ITEM 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:background="@drawable/rounded_bar_gray"
                android:layout_width="28dp"
                android:layout_height="28dp"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Discover matching jobs"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Smart matching based on your skills and location"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FEATURE ITEM 2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:background="@drawable/rounded_bar_gray"
                android:layout_width="28dp"
                android:layout_height="28dp"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Track your applications"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Real-time status updates from employers"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FEATURE ITEM 3 -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:background="@drawable/rounded_bar_gray"
                android:layout_width="28dp"
                android:layout_height="28dp"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="One-tap apply with resume"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#000000"
                    android:layout_marginBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Upload once, apply to hundreds of jobs"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CREATE ACCOUNT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/createAccountBtn"
            android:text="Create an Account"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#000000"
            app:cornerRadius="10dp"
            app:elevation="0dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <!-- LOG IN BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginBtn"
            android:text="Log In"
            android:textColor="#000000"
            android:textSize="15sp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            app:elevation="0dp"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="50dp"/>

        <!-- TERMS -->
        <TextView
            android:text="By continuing, you agree to our Terms of Service and Privacy Policy"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</FrameLayout>